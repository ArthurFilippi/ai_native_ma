# LLM provider: mock (offline, deterministic) | gemini | openai
LLM_PROVIDER=mock
LLM_MODEL=
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_CACHE_DIR=data/cache/llm
LLM_MAX_CONCURRENCY=4
LLM_TIMEOUT_S=60
# a failed live call answers 503; true lets the mock answer instead, marked `degraded`
LLM_ALLOW_MOCK_FALLBACK=false
# judge model, distinct from the writer (empty: the writer judges, and the trace says so)
JUDGE_PROVIDER=
JUDGE_MODEL=

# Retrieval backends: lsa|fastembed (embeddings), features|cross_encoder (reranker)
EMBEDDINGS_BACKEND=lsa
EMBEDDINGS_MODEL=BAAI/bge-small-en-v1.5
RERANKER_BACKEND=features

# Store: sqlite (default, zero infrastructure) | postgres (Supabase, later milestone)
STORE_BACKEND=sqlite
SQLITE_PATH=data/cache/ainma.sqlite
DATABASE_URL=

# API
DEMO_AUTH=true
ALLOWED_ORIGINS=http://localhost:3000
SEED=1234
